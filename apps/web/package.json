{
  "name": "@jokger/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.unit.ts --coverage",
    "test:unit": "vitest run --config vitest.config.unit.ts",
    "test:component": "vitest run --config vitest.config.component.ts",
    "test:e2e": "playwright test",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \"playwright.config.ts\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\" \"e2e/**/*.ts\" \"playwright.config.ts\" \"vitest.config*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css,md}\" \"e2e/**/*.ts\" \"playwright.config.ts\" \"vitest.config*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@solidjs/router": "^0.13.0",
    "@supabase/supabase-js": "^2.43.0",
    "date-fns": "^3.6.0",
    "lucide-solid": "^0.554.0",
    "solid-js": "^1.9.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^8.57.0",
    "@playwright/test": "^1.45.0",
    "@solidjs/testing-library": "^0.8.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitest/coverage-v8": "5.0.3",
    "autoprefixer": "^10.4.19",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "eslint-plugin-solid": "^0.14.0",
    "globals": "^15.15.0",
    "jsdom": "^24.1.3",
    "postcss": "^8.4.38",
    "prettier": "^3.2.0",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "5.0.3"
  }
}
